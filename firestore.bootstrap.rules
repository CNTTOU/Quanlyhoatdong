rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ dùng tạm thời để seed dữ liệu và tạo admin đầu tiên.
    // Sau khi tạo xong tài khoản, deploy lại firestore.rules ngay.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
