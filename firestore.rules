rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isSignedIn();
    }

    function getUserData() {
      return request.auth.token;
    }

    function isActiveUser() {
      return hasUserProfile()
        && getUserData().trang_thai in ['dang_hoat_dong', 'cho_doi_mat_khau'];
    }

    function hasRole(role) {
      return isActiveUser()
        && (getUserData().ma_vai_tro == role || getUserData().role == role);
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function hasPermission(permission) {
      return isActiveUser()
        && getUserData().permissions is list
        && permission in getUserData().permissions;
    }

    function isAdmin() {
      return isSuperAdmin() || hasRole('admin_doan_hoi');
    }

    match /quyen/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /vai_tro/{id} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin() || hasPermission('quan_ly_phan_quyen');
    }

    match /nguoi_dung/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ma_vai_tro', 'ten_vai_tro', 'trang_thai']));
      allow delete: if isSuperAdmin();
    }

    match /don_vi/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /loai_don_vi/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /nam_hoc/{id} {
      allow read: if isActiveUser();
      allow create, update: if isSuperAdmin() || hasPermission('tao_goi_luu_tru');
      allow delete: if isSuperAdmin() || hasPermission('xoa_du_lieu_nam_hoc');
    }

    match /loai_hoat_dong/{id} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin() || hasPermission('cai_dat_he_thong');
    }

    match /hoat_dong/{id} {
      allow read: if isActiveUser()
        || (resource.data.trang_thai == 'da_duyet' && resource.data.hien_thi_noi_bat == true);
      allow create, update, delete: if false;
    }

    match /minh_chung/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if false;
    }

    match /duyet_hoat_dong/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if false;
    }

    match /mau_bao_cao/{id} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin() || hasPermission('cai_dat_he_thong');
    }

    match /bao_cao_da_tao/{id} {
      allow read: if isActiveUser();
      allow create: if hasPermission('tao_bao_cao');
      allow update, delete: if isSuperAdmin() || hasPermission('tao_bao_cao');
    }

    match /luu_tru_nam_hoc/{id} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin();
    }

    match /nhat_ky_he_thong/{id} {
      allow read: if isAdmin();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    match /cai_dat_he_thong/{id} {
      allow read: if isActiveUser() || id in ['thong_tin_chung', 'giao_dien', 'hoat_dong_noi_bat'];
      allow write: if isSuperAdmin()
        || hasPermission('cai_dat_he_thong')
        || (id == 'hoat_dong_noi_bat' && hasPermission('quan_ly_hoat_dong_noi_bat'))
        || hasPermission('tao_goi_luu_tru')
        || hasPermission('xoa_du_lieu_nam_hoc');
    }

    match /thong_bao/{id} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

  }
}
